# 64-bit specific architecture and ISA settings
CONFIG_ARCH_RV64I=y
CONFIG_RISCV_ISA_A=y
CONFIG_RISCV_ISA_C=y
CONFIG_CMODEL_MEDANY=y

CONFIG_TEXT_BASE=0x802040000
CONFIG_SYS_TEXT_BASE=0x8002040000
CONFIG_DEBUG_UART_BASE=0x08030000

CONFIG_BOOTCOMMAND="setenv kernel_addr_r 0x808000000;setenv fdt_addr_r 0x809000000;setenv fdt_high 0xffffffffffffffff;fatload mmc 0:1 ${kernel_addr_r} Image;fatload mmc 0:1 ${fdt_addr_r} linux.dtb;booti ${kernel_addr_r} - ${fdt_addr_r}"
