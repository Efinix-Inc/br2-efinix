+			val = get_unaligned_le32(buf + i * sizeof(u32));
+		efx_emmc_writel(host, val, EFX_EMMC_BUFFER_DATA_PORT);
 	}
 
 	host->bytes_to_transfer -= data->blocksize;
 	host->blocks_done++;
+
+	return 0;
 }
 
-static void efx_emmc_transfer_pio(struct efx_emmc_host *host)
+static int efx_emmc_transfer_pio(struct efx_emmc_host *host)
 {
 	struct mmc_data *data = host->data;
 	int blocks_remaining = data->blocks;
+	int ret;
 
 	while (blocks_remaining > 0 && host->bytes_to_transfer > 0) {
-		if (data->flags & MMC_DATA_READ) {
-			efx_emmc_read_block_pio(host);
-		} else {
-			efx_emmc_write_block_pio(host);
-		}
+		if (data->flags & MMC_DATA_READ)
+			ret = efx_emmc_read_block_pio(host);
+		else
+			ret = efx_emmc_write_block_pio(host);
+		if (ret)
+			return ret;
+
 		blocks_remaining--;
 	}
+
+	return 0;
 }
 
