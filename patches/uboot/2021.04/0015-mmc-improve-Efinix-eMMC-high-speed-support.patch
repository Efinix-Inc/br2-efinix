-                                         EFX_EMMC_INT_BUFFER_WRITE_RDY | \
-                                         EFX_EMMC_INT_XFER_COMPLETE | \
-                                         EFX_EMMC_INT_CMD_COMPLETE)
+					 EFX_EMMC_INT_BUFFER_READ_RDY | \
+					 EFX_EMMC_INT_BUFFER_WRITE_RDY | \
+					 EFX_EMMC_INT_XFER_COMPLETE | \
+					 EFX_EMMC_INT_CMD_COMPLETE)
 
 /* System Reset Register bits */
 #define EFX_SYS_RESET_EMMC_DEV          BIT(1)
@@ -133,8 +133,14 @@
 
