 /* Register access helpers */
 static inline u32 efx_emmc_readl(struct efx_emmc_host *host, u32 reg)
 {
@@ -219,6 +235,19 @@
 	udelay(EFX_EMMC_POST_RESET_DELAY);
 }
 
+static void efx_emmc_reset_ip(struct efx_emmc_host *host)
+{
+	u32 reg;
+
+	reg = efx_emmc_sys_readl(host, EFX_SYS_RESET_REG);
+	efx_emmc_sys_writel(host, reg | EFX_SYS_RESET_EMMC_IP,
+			     EFX_SYS_RESET_REG);
+	udelay(EFX_EMMC_RESET_PULSE_WIDTH);
+	efx_emmc_sys_writel(host, reg & ~EFX_SYS_RESET_EMMC_IP,
+			     EFX_SYS_RESET_REG);
+	udelay(EFX_EMMC_RESET_PULSE_WIDTH);
+}
+
 static void efx_emmc_set_clock(struct efx_emmc_host *host, unsigned int clock)
 {
 	u32 div, reg;
@@ -274,12 +303,15 @@
 	host->current_clk = host->base_clk / div;
 }
 
-static void efx_emmc_set_bus_width(struct efx_emmc_host *host, int width)
+static void efx_emmc_set_bus_mode(struct efx_emmc_host *host, int width,
+				  bool ddr)
 {
 	u32 reg;
 
 	reg = efx_emmc_readl(host, EFX_EMMC_HOST_CONTROL);
-	reg &= ~EFX_EMMC_DATA_WIDTH_MASK;
+	reg &= ~(EFX_EMMC_DATA_WIDTH_MASK | EFX_EMMC_DDR_MODE);
+	if (ddr)
+		reg |= EFX_EMMC_DDR_MODE;
 
 	switch (width) {
 	case 1:
@@ -299,6 +331,25 @@
 
 }
 
+static void efx_emmc_recover(struct efx_emmc_host *host)
+{
+	unsigned int clock = host->current_clk;
+	unsigned int width = host->mmc->bus_width ?: 1;
+
+	efx_emmc_reset_ip(host);
+	efx_emmc_writel(host, 0, EFX_EMMC_INT_SIGNAL_EN);
+	efx_emmc_writel(host, EFX_EMMC_INT_ALL_MASK, EFX_EMMC_INT_STATUS);
+	efx_emmc_set_bus_mode(host, width, host->mmc->ddr_mode);
+	efx_emmc_set_clock(host, clock);
+	efx_emmc_writel(host, EFX_EMMC_INT_ALL_MASK, EFX_EMMC_INT_STATUS_EN);
+
+#ifdef MMC_SUPPORTS_TUNING
+	if (host->tuned)
+		efx_emmc_set_tuning(host, host->tuning_sample,
+				    host->tuning_pll);
+#endif
+}
