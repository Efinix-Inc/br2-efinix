+#ifdef MMC_SUPPORTS_TUNING
+static int efx_emmc_execute_tuning(struct udevice *dev, uint opcode);
+static void efx_emmc_set_tuning(struct efx_emmc_host *host, u32 sample,
+				u32 pll_shift);
+#endif
