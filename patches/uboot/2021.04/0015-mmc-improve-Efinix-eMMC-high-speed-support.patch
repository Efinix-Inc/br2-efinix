From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Teoh Choon Zone <czteoh@efinixinc.com>
Date: Thu, 13 Aug 2026 12:00:00 +0800
Subject: [PATCH] mmc: improve Efinix eMMC high-speed support

Add HS200/HS400 tuning, DDR bus-mode handling, controller recovery,
bounded PIO waits, and stricter transfer validation.

Signed-off-by: Teoh Choon Zone <czteoh@efinixinc.com>
---
 drivers/mmc/Kconfig    |   1 +
 drivers/mmc/efx_emmc.c | 486 ++++++++++++++++++++++++++++++-----------
 2 files changed, 342 insertions(+), 145 deletions(-)

diff --git a/drivers/mmc/Kconfig b/drivers/mmc/Kconfig
index 25442ffdb4a4..bfcbbd31d68e 100644
--- a/drivers/mmc/Kconfig
+++ b/drivers/mmc/Kconfig
@@ -484,6 +484,7 @@
 config MMC_EFX_EMMC
 	bool "Efinix eMMC host controller"
 	depends on DM_MMC && BLK && OF_CONTROL
+	select MMC_HS400_SUPPORT
 	help
 	  This enables support for the Efinix eMMC Host Controller.
 	  The controller supports eMMC 5.1 specification with HS200 and HS400 modes.
diff --git a/drivers/mmc/efx_emmc.c b/drivers/mmc/efx_emmc.c
