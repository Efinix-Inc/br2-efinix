-			      efx_emmc_readl(host, EFX_EMMC_PRESENT_STATE));
-			return -ETIMEDOUT;
-		}
-	}
-
 	return 0;
 }
 
 static int efx_emmc_wait_interrupt(struct efx_emmc_host *host, u32 mask, int timeout_ms)
 {
 	u32 intstat;
+	u32 wait_mask = mask | EFX_EMMC_INT_ERROR_MASK;
+	bool tuning = host->cmd && mmc_is_tuning_cmd(host->cmd->cmdidx);
 	int timeout_us = timeout_ms * 1000;
 	int ret;
 
 	ret = readl_poll_timeout(host->ioaddr + EFX_EMMC_INT_STATUS,
 				 intstat,
-				 (intstat & mask),
+				 (intstat & wait_mask),
 				 timeout_us);
 
 	if (ret) {
-		printf("Wait interrupt timeout: mask=0x%08x, status=0x%08x\n",
-		      mask, efx_emmc_readl(host, EFX_EMMC_INT_STATUS));
+		if (!tuning)
+			printf("Wait interrupt timeout: mask=0x%08x, status=0x%08x\n",
+			       mask, efx_emmc_readl(host, EFX_EMMC_INT_STATUS));
 		return -ETIMEDOUT;
 	}
 
-	/* Clear the interrupt */
-	efx_emmc_writel(host, intstat & mask, EFX_EMMC_INT_STATUS);
+	/* Clear the completion or error that ended the wait. */
+	efx_emmc_writel(host, intstat & wait_mask, EFX_EMMC_INT_STATUS);
 
-	/* Check for errors */
 	if (intstat & EFX_EMMC_INT_ERROR_MASK) {
+		if (!tuning)
+			dev_dbg(host->dev, "interrupt error: cmd=%u status=0x%08x\n",
+				host->cmd ? host->cmd->cmdidx : 0, intstat);
 		return -EIO;
 	}
 
 	return 0;
 }
 
-static void efx_emmc_read_block_pio(struct efx_emmc_host *host)
+static int efx_emmc_wait_buffer_ready(struct efx_emmc_host *host, u32 mask)
+{
+	unsigned long start = get_timer(0);
+	u32 intstat, state;
+
+	do {
+		intstat = efx_emmc_readl(host, EFX_EMMC_INT_STATUS);
+		if (intstat & EFX_EMMC_INT_ERROR_MASK) {
+			efx_emmc_writel(host, intstat & EFX_EMMC_INT_ERROR_MASK,
+					 EFX_EMMC_INT_STATUS);
+			return -EIO;
+		}
+
+		state = efx_emmc_readl(host, EFX_EMMC_PRESENT_STATE);
+		if (state & mask)
+			return 0;
+
+		udelay(1);
+	} while (get_timer(start) < EFX_EMMC_PIO_TIMEOUT_MS);
+
+	return -ETIMEDOUT;
+}
+
+static int efx_emmc_read_block_pio(struct efx_emmc_host *host)
 {
 	struct mmc_data *data = host->data;
-	u32 *buf = (u32 *)((u8 *)data->dest + (data->blocksize * host->blocks_done));
+	u8 *buf = (u8 *)data->dest +
+		  (size_t)data->blocksize * host->blocks_done;
+	bool aligned = IS_ALIGNED((uintptr_t)buf, sizeof(u32));
 	int words = data->blocksize / 4;
 	int i;
-	u32 present_state;
-	int timeout = 100000; /* Timeout counter */
-
-	if (words == 0) {
-		return;
-	}
+	int ret;
+	u32 val;
 
 	for (i = 0; i < words; i++) {
-		/* Wait for data available with timeout */
-		timeout = 10000; /* Reduced timeout with delay */
-		do {
-			present_state = efx_emmc_readl(host, EFX_EMMC_PRESENT_STATE);
-			if (!(present_state & EFX_EMMC_BUFFER_READ_EN)) {
-				udelay(1); /* Small delay to prevent system hang */
-			}
-			timeout--;
-		} while (!(present_state & EFX_EMMC_BUFFER_READ_EN) && timeout > 0);
-		
-		if (timeout <= 0) {
-			printf("PIO read timeout waiting for data word %d/%d, present_state=0x%08x\n", 
-			       i, words, present_state);
-			break;
+		if (!(efx_emmc_readl(host, EFX_EMMC_PRESENT_STATE) &
+		      EFX_EMMC_BUFFER_READ_EN)) {
+			ret = efx_emmc_wait_buffer_ready(host,
+						 EFX_EMMC_BUFFER_READ_EN);
+			if (ret)
+				return ret;
 		}
 
-		buf[i] = efx_emmc_readl(host, EFX_EMMC_BUFFER_DATA_PORT);
+		val = efx_emmc_readl(host, EFX_EMMC_BUFFER_DATA_PORT);
+		if (aligned)
+			((u32 *)buf)[i] = val;
+		else
+			put_unaligned_le32(val, buf + i * sizeof(u32));
 	}
 
 	host->bytes_to_transfer -= data->blocksize;
 	host->blocks_done++;
+
+	return 0;
 }
 
-static void efx_emmc_write_block_pio(struct efx_emmc_host *host)
+static int efx_emmc_write_block_pio(struct efx_emmc_host *host)
 {
 	struct mmc_data *data = host->data;
-	u32 *buf = (u32 *)((u8 *)data->src + (data->blocksize * host->blocks_done));
