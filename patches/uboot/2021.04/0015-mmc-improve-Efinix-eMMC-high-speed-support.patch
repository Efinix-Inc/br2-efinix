 static int efx_emmc_set_ios(struct udevice *dev)
 {
-    struct efx_emmc_host *host = dev_get_priv(dev);
-    struct mmc *mmc = mmc_get_mmc_dev(dev);
+	struct efx_emmc_host *host = dev_get_priv(dev);
+	struct mmc *mmc = mmc_get_mmc_dev(dev);
+
+	if (mmc->clock != host->current_clk) {
+		efx_emmc_set_clock(host, mmc->clock);
+		mmc->clock = host->current_clk;
+	}
+
+	if (mmc->bus_width)
+		efx_emmc_set_bus_mode(host, mmc->bus_width, mmc->ddr_mode);
+
+#ifdef MMC_SUPPORTS_TUNING
+	if (host->tuned && mmc->selected_mode != MMC_HS_200 &&
+	    mmc->selected_mode != MMC_HS_400) {
+		efx_emmc_set_tuning(host, 0, 0);
+		host->tuned = false;
+		host->tuning_sample = 0;
+		host->tuning_pll = 0;
+	}
+#endif
+
+#if CONFIG_IS_ENABLED(MMC_HS400_SUPPORT)
+	if (mmc->selected_mode != MMC_HS_400) {
+		host->hs400_tuned = false;
+	} else if (!host->hs400_tuned) {
+		/* This controller requires a second scan on the HS400 receive path. */
+		host->hs400_tuned = true;
+		return efx_emmc_execute_tuning(dev,
+				MMC_CMD_SEND_TUNING_BLOCK_HS200);
+	}
+#endif
 
-    if (mmc->clock != host->current_clk) {
-        efx_emmc_set_clock(host, mmc->clock);
-    }
