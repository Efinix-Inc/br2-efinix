 #define EFX_EMMC_MIN_FREQ               400000    /* 400 KHz */
+#define EFX_EMMC_HS_MODE_MIN_FREQ       50000000  /* 50 MHz */
 #define EFX_EMMC_MAX_FREQ               200000000 /* 200 MHz */
 #define EFX_EMMC_PIO_TIMEOUT_MS         1000
