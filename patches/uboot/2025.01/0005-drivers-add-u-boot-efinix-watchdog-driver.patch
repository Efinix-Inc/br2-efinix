From 5ec1e67d7788975991eba629e925bda9873f99c3 Mon Sep 17 00:00:00 2001
From: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
Date: Mon, 1 Dec 2025 14:12:07 +0800
Subject: [PATCH] drivers: add u-boot efinix watchdog driver

Signed-off-by: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
---
 drivers/watchdog/Kconfig      |   8 +++
 drivers/watchdog/Makefile     |   1 +
 drivers/watchdog/efinix_wdt.c | 117 ++++++++++++++++++++++++++++++++++
 3 files changed, 126 insertions(+)
 create mode 100644 drivers/watchdog/efinix_wdt.c

diff --git a/drivers/watchdog/Kconfig b/drivers/watchdog/Kconfig
index 0e45f0a0922..61614e73232 100644
--- a/drivers/watchdog/Kconfig
+++ b/drivers/watchdog/Kconfig
@@ -86,6 +86,13 @@ config WDT
 	  What exactly happens when the timer expires is up to a particular
 	  device/driver.
 
+config WDT_EFINIX
+	bool "Efinix watchdog timer support"
+	depends on WDT
+	imply WATCHDOG
+	help
+	  Enable the watchdog driver support on Efinix SoC.
+
 config WDT_APPLE
 	bool "Apple watchdog timer support"
 	depends on WDT
@@ -443,4 +450,5 @@ config WDT_FTWDT010
 	help
 	  Faraday Technology ftwdt010 watchdog is an architecture independent
 	  watchdog. It is usually used in SoC chip design.
+
 endmenu
diff --git a/drivers/watchdog/Makefile b/drivers/watchdog/Makefile
index 0b107c008f7..f67fb0d6d2a 100644
--- a/drivers/watchdog/Makefile
+++ b/drivers/watchdog/Makefile
@@ -52,3 +52,4 @@ obj-$(CONFIG_WDT_STM32MP) += stm32mp_wdt.o
 obj-$(CONFIG_WDT_SUNXI) += sunxi_wdt.o
 obj-$(CONFIG_WDT_TANGIER) += tangier_wdt.o
 obj-$(CONFIG_WDT_XILINX) += xilinx_wwdt.o
+obj-$(CONFIG_WDT_EFINIX) += efinix_wdt.o
diff --git a/drivers/watchdog/efinix_wdt.c b/drivers/watchdog/efinix_wdt.c
new file mode 100644
index 00000000000..5580d717a3c
--- /dev/null
+++ b/drivers/watchdog/efinix_wdt.c
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Support for watchdog on Efinix Inc SoC
+ *
+ * Copyright (C) 2025 Efinix Inc
+ */
+#include <linux/types.h>
+#include <wdt.h>
+#include <asm/io.h>
+#include <dm.h>
+#include <dm/device_compat.h>
+
+#define EFX_WDT_DEFAULT_TIME	60	/* in seconds */
+#define EFX_WDT_MAX_TIME	3600U
+#define EFX_WDT_RESET		0xAD68E70D	/* Magic number to reset the watchdog */
+#define EFX_WDT_UNLOCK		0x3C21B925	/* Magic number to unlock the watchdog */
+#define EFX_WDT_LOCK		0x3C21B924	/* Magic number to lock the watchdog */
+
+#define EFX_WDT_HEARTBEAT	0x00
+#define EFX_WDT_ENABLE		0x04
+#define EFX_WDT_DISABLE		0x08
+#define EFX_WDT_ENA_COUNTER_0	(1 << 0)
+#define EFX_WDT_ENA_COUNTER_1	(1 << 1)
+#define EFX_WDT_PRESCALER	0x40
+#define EFX_WDT_COUNTER_0	0x80
+#define EFX_WDT_COUNTER_1	0x84
+
+struct efx_wdt_dev {
+	void __iomem *base;
+};
+
+static void efx_wdt_lock(struct efx_wdt_dev *wdev)
+{
+	writel(EFX_WDT_LOCK, wdev->base + EFX_WDT_HEARTBEAT);
+}
+
+static void efx_wdt_unlock(struct efx_wdt_dev *wdev)
+{
+	writel(EFX_WDT_UNLOCK, wdev->base + EFX_WDT_HEARTBEAT);
+}
+
+static int efx_wdt_stop(struct udevice *dev)
+{
+	struct efx_wdt_dev *wdev = dev_get_priv(dev);
+	debug("%s\n", __func__);
+	efx_wdt_unlock(wdev);
+	writel(EFX_WDT_ENA_COUNTER_0 | EFX_WDT_ENA_COUNTER_1, wdev->base + EFX_WDT_DISABLE);
+	efx_wdt_lock(wdev);
+
+	return 0;
+}
+
+static int efx_wdt_reset(struct udevice *dev)
+{
+	struct efx_wdt_dev *wdev = dev_get_priv(dev);
+	debug("%s: Reset the watchdog\n", __func__);
+	writel(EFX_WDT_RESET, wdev->base + EFX_WDT_HEARTBEAT);
+
+	return 0;
+}
+
+static int efx_wdt_start(struct udevice *dev, u64 timeout_ms,
+			 ulong flags)
+{
+	struct efx_wdt_dev *wdev = dev_get_priv(dev);
+
+	efx_wdt_reset(dev);
+	debug("%s: Start the watchdog, timeout_ms=%llu\n", __func__, timeout_ms);
+	efx_wdt_unlock(wdev);
+	writel(timeout_ms, wdev->base + EFX_WDT_COUNTER_1);	
+	writel(EFX_WDT_ENA_COUNTER_1, wdev->base + EFX_WDT_ENABLE);
+	efx_wdt_lock(wdev);
+
+	return 0;
+}
+
+static const struct wdt_ops efx_wdt_ops = {
+	.start = efx_wdt_start,
+	.reset = efx_wdt_reset,
+	.stop = efx_wdt_stop,
+};
+
+static int efx_wdt_probe(struct udevice *dev)
+{
+	struct efx_wdt_dev *wdev = dev_get_priv(dev);
+	unsigned long clk_f;
+	unsigned int prescaler;
+
+	debug("%s\n", __func__);
+	wdev->base = dev_read_addr_ptr(dev);
+	if (!wdev->base) {
+		dev_info(dev, "Failed to get base address of watchdog device\n");
+		return -ENOENT;
+	}
+
+	clk_f = dev_read_u32_default(dev, "clock-frequency", 200000000); 
+
+	prescaler = (clk_f / 1000) -1;
+	writel(prescaler, wdev->base + EFX_WDT_PRESCALER);
+
+	dev_info(dev, "Successfully register watchdog driver\n");
+	return 0;
+}
+
+static const struct udevice_id efx_wdt_ids[] = {
+	{ .compatible = "efx,efx-wdt" },
+	{ }
+};
+
+U_BOOT_DRIVER(efx_wdt) = {
+	.name = "efx-watchdog",
+	.id = UCLASS_WDT,
+	.of_match = efx_wdt_ids,
+	.ops = &efx_wdt_ops,
+	.probe = efx_wdt_probe,
+	.priv_auto = sizeof(struct efx_wdt_dev),
+};
-- 
2.43.0

