From 824c475337b9569071b3b26481938630d20b5eac Mon Sep 17 00:00:00 2001
From: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
Date: Mon, 23 Jun 2025 23:45:52 +0800
Subject: [PATCH] board/vexriscv: add support for saxon vexriscv board

Signed-off-by: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
---
 arch/riscv/Kconfig            |   3 +
 arch/riscv/dts/Makefile       |   1 +
 board/vexriscv/saxon/Kconfig  |  27 +++++++++
 board/vexriscv/saxon/Makefile |   5 ++
 board/vexriscv/saxon/saxon.c  | 100 ++++++++++++++++++++++++++++++++++
 include/configs/saxon.h       |  63 +++++++++++++++++++++
 6 files changed, 199 insertions(+)
 create mode 100644 board/vexriscv/saxon/Kconfig
 create mode 100644 board/vexriscv/saxon/Makefile
 create mode 100644 board/vexriscv/saxon/saxon.c
 create mode 100644 include/configs/saxon.h

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 043d963f634..4e283b32e12 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -49,6 +49,8 @@ config TARGET_XILINX_MBV
 config TARGET_ASPEED_AST2700_IBEX
 	bool "Support Ibex RISC-V cores on Aspeed AST2700 SoC"
 
+config TARGET_VEXRISCV_SAXON
+	bool "Support Saxon Board"
 endchoice
 
 config SYS_ICACHE_OFF
@@ -95,6 +97,7 @@ source "board/sophgo/milkv_duo/Kconfig"
 source "board/starfive/visionfive2/Kconfig"
 source "board/thead/th1520_lpi4a/Kconfig"
 source "board/xilinx/mbv/Kconfig"
+source "board/vexriscv/saxon/Kconfig"
 
 # platform-specific options below
 source "arch/riscv/cpu/andes/Kconfig"
diff --git a/arch/riscv/dts/Makefile b/arch/riscv/dts/Makefile
index de356584bf1..f23742417ae 100644
--- a/arch/riscv/dts/Makefile
+++ b/arch/riscv/dts/Makefile
@@ -12,6 +12,7 @@ dtb-$(CONFIG_TARGET_TH1520_LPI4A) += th1520-lichee-pi-4a.dtb
 dtb-$(CONFIG_TARGET_XILINX_MBV) += xilinx-mbv32.dtb
 dtb-$(CONFIG_TARGET_XILINX_MBV) += xilinx-mbv64.dtb
 dtb-$(CONFIG_TARGET_ASPEED_AST2700_IBEX) += ast2700-ibex.dtb
+dtb-$(CONFIG_TARGET_VEXRISCV_SAXON) += uboot.dtb
 
 include $(srctree)/scripts/Makefile.dts
 
diff --git a/board/vexriscv/saxon/Kconfig b/board/vexriscv/saxon/Kconfig
new file mode 100644
index 00000000000..723adcf78be
--- /dev/null
+++ b/board/vexriscv/saxon/Kconfig
@@ -0,0 +1,27 @@
+if TARGET_VEXRISCV_SAXON
+
+config SYS_BOARD
+       default "saxon"
+
+config SYS_VENDOR
+       default "vexriscv"
+
+config SYS_CPU
+       default "generic"
+
+config SYS_CONFIG_NAME
+       default "saxon"
+
+config SYS_TEXT_BASE
+	hex "Text base"
+	default 0x2040000
+
+config SYS_LOAD_ADDR
+	hex "Load address"
+	default 0x2040000
+
+config BOARD_SPECIFIC_OPTIONS # dummy
+       def_bool y
+       select GENERIC_RISCV
+
+endif
diff --git a/board/vexriscv/saxon/Makefile b/board/vexriscv/saxon/Makefile
new file mode 100644
index 00000000000..6f86c022eb1
--- /dev/null
+++ b/board/vexriscv/saxon/Makefile
@@ -0,0 +1,5 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Copyright (C) 2019 roman3017 <rbacik@hotmail.com>
+
+obj-y  = saxon.o
diff --git a/board/vexriscv/saxon/saxon.c b/board/vexriscv/saxon/saxon.c
new file mode 100644
index 00000000000..a6b0e03e469
--- /dev/null
+++ b/board/vexriscv/saxon/saxon.c
@@ -0,0 +1,100 @@
+#include <spl.h>
+#include <log.h>
+
+int board_init(void)
+{
+       debug("%s\n",__func__);
+       return 0;
+}
+
+#ifdef CONFIG_SPL_BUILD
+DECLARE_GLOBAL_DATA_PTR;
+
+void spl_board_init(void)
+{
+       debug("%s\n",__func__);
+}
+u32 spl_boot_device(void)
+{
+#ifdef CONFIG_SPL_MMC_SUPPORT
+       return BOOT_DEVICE_MMC1;
+#endif
+       return BOOT_DEVICE_NONE;
+}
+
+#ifdef CONFIG_SPL_OS_BOOT
+int spl_start_uboot(void)
+{
+       debug("%s\n",__func__);
+       return 0;
+}
+void spl_perform_fixups(struct spl_image_info *spl_image)
+{
+       spl_image->os = IH_OS_LINUX;
+       spl_image->arg = (void *)CONFIG_SYS_SPL_ARGS_ADDR;
+       spl_image->entry_point = CONFIG_SYS_SPL_KERNEL_ADDR;
+}
+
+void __noreturn jump_to_image_linux(struct spl_image_info *spl_image)
+{
+       printf("Entering kernel: 0x%x, arg pointer: 0x%x\n", (u32)spl_image->entry_point, (u32)spl_image->arg);
+       typedef void (*image_entry_arg_t)(ulong, void *)
+               __attribute__ ((noreturn));
+       image_entry_arg_t kernel =
+               (image_entry_arg_t)spl_image->entry_point;
+       kernel(gd->arch.boot_hart, spl_image->arg);
+}
+#endif /* CONFIG_SPL_OS_BOOT */
+
+/* DO NOT enable SPL_OF_LIBFDT without SPL_OF_CONTROL */
+#if !defined(CONFIG_SPL_OF_LIBFDT)
+s32 fdtdec_get_int(const void *blob, int node, const char *prop_name, s32 default_val)
+{
+       debug("%s\n",__func__);
+       return -1;
+}
+const void *fdt_getprop(const void *fdt, int nodeoffset, const char *name, int *lenp)
+{
+       debug("%s\n",__func__);
+       return NULL;
+}
+int fdt_first_subnode(const void *fdt, int offset)
+{
+       debug("%s\n",__func__);
+       return -1;
+}
+int fdt_next_subnode(const void *fdt, int offset)
+{
+       debug("%s\n",__func__);
+       return -1;
+}
+int fdt_path_offset(const void *fdt, const char *path)
+{
+       debug("%s\n",__func__);
+       return -1;
+}
+
+int fdtdec_setup_mem_size_base(void)
+{
+       debug("%s\n",__func__);
+       gd->ram_base = CONFIG_SYS_SPL_RAM_BASE;
+       gd->ram_size = CONFIG_SYS_SPL_RAM_SIZE;
+       gd->ram_top = gd->ram_base + gd->ram_size - 1;
+       return 0;
+}
+int fdtdec_setup_memory_banksize(void)
+{
+       debug("%s\n",__func__);
+       gd->bd->bi_memstart = gd->ram_base;
+       gd->bd->bi_memsize = gd->ram_size;
+       gd->bd->bi_dram[0].start = gd->ram_base;
+       gd->bd->bi_dram[0].size = gd->ram_size;
+       return 0;
+}
+int dm_scan_fdt_dev(struct udevice *dev)
+{
+       debug("%s\n",__func__);
+       return 0;
+}
+#endif /* !CONFIG_SPL_OF_LIBFDT */
+#endif /* CONFIG_SPL_BUILD */
diff --git a/include/configs/saxon.h b/include/configs/saxon.h
new file mode 100644
index 00000000000..365f407e39f
--- /dev/null
+++ b/include/configs/saxon.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Copyright (C) 2019 roman3017 <rbacik@hotmail.com>
+ *
+ */
+
+#ifndef __CONFIG_H
+#define __CONFIG_H
+
+#include <linux/sizes.h>
+
+/* DRAM window (matches bdinfo): 0x0040_0000 .. 0x3FFF_FFFF (≈1020 MiB)  */
+#define CONFIG_SYS_SDRAM_BASE	0x00400000UL
+#define CONFIG_SYS_SDRAM_SIZE	0x3FC00000UL   /* 1020 MiB */
+
+/* Default load address for images (kernel/FIT/DTB) — keep low in DRAM */
+//#define CONFIG_SYS_LOAD_ADDR	0x00400000UL
+
+/* Initial stack and malloc must live in DRAM — do NOT tie to LOAD_ADDR */
+
+/* Small on-chip SRAM (if present) for very early use; otherwise keep minimal */
+#define CFG_SYS_INIT_RAM_ADDR        0x00f90000UL  /* optional, if you really have SRAM here */
+#define CFG_SYS_INIT_RAM_SIZE        0x00004000UL   /* 16 KiB */
+
+/* Place the initial SP near the top of DRAM (below reserved/LMB cushion) */
+#undef  CONFIG_SYS_INIT_SP_ADDR
+#define CONFIG_SYS_INIT_SP_ADDR (CONFIG_SYS_SDRAM_BASE + CONFIG_SYS_SDRAM_SIZE - 0x10000UL)
+
+/* Early/normal malloc arenas inside DRAM */
+#define CONFIG_SYS_MALLOC_LEN   (16 * 1024 * 1024) /* 16 MiB main heap */
+#define CONFIG_SYS_MALLOC_F_LEN (1  * 1024 * 1024) /* 1 MiB early malloc (if enabled) */
+
+/* Text base: align with OpenSBI “Next Address” (from your boot log) */
+#define CONFIG_SYS_TEXT_BASE         0x02040000UL
+
+/* Environment defaults */
+#define CONFIG_EXTRA_ENV_SETTINGS "initrd_high=0xffffffff\0" \
+                                  "fdt_high=0xffffffff\0"
+
+/* SPL section — keep everything inside DRAM (DRAM starts at 0x0040_0000) */
+#ifdef CONFIG_SPL_BUILD
+/* Scratch RAM and sizes for SPL */
+#define CONFIG_SYS_SPL_RAM_BASE		0x02000000UL     /* 32 MiB region in DRAM */
+#define CONFIG_SYS_SPL_RAM_SIZE		(SZ_8M)/* 8 MiB scratch */
+
+/* SPL .bss placement - keep inside DRAM */
+#define CONFIG_SPL_MAX_SIZE		CONFIG_SPL_SIZE_LIMIT
+#define CONFIG_SPL_BSS_MAX_SIZE		(SZ_4K)
+#define CONFIG_SPL_BSS_START_ADDR	(IMAGE_TEXT_BASE + CONFIG_SPL_MAX_SIZE - CONFIG_SPL_BSS_MAX_SIZE)
+
+/* MMC/FS loading parameters (keep address in DRAM) */
+#define CONFIG_SYS_MMCSD_RAW_MODE_KERNEL_SECTOR 0
+#define CONFIG_SYS_MMCSD_FS_BOOT_PARTITION 1
+
+/* Arguments/Kernel handoff buffer (in DRAM) */
+#define CONFIG_SYS_SPL_ARGS_ADDR 0x02047000UL
+#define CONFIG_SYS_SPL_KERNEL_ADDR 0x02048000UL
+
+/* Filename for SPL filesystem loaders */
+#define CONFIG_SPL_FS_LOAD_ARGS_NAME "dtb"
+#define CONFIG_SPL_FS_LOAD_KERNEL_NAME CONFIG_SPL_PAYLOAD
+#endif /* CONFIG_SPL_BUILD */
+#endif /* __CONFIG_H */
-- 
2.43.0

