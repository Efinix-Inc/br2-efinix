+++ b/package/libfm/libfm.mk
@@ -4,16 +4,17 @@
 #
 ################################################################################
 
-LIBFM_VERSION = 1.3.2
-LIBFM_SOURCE = libfm-$(LIBFM_VERSION).tar.xz
-LIBFM_SITE = http://sourceforge.net/projects/pcmanfm/files
