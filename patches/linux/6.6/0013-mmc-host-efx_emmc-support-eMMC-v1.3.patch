+        }
+
+        max_consecutive_length = efx_emmc_find_longest_consecutive_ones(flat_map, flat_length);
+        dev_dbg(&host->pdev->dev, "Best consecutive length in flat map: %d\n", max_consecutive_length);
+        if (max_consecutive_length < EFX_EMMC_MIN_TIMING_MARGIN) {
+            dev_warn(&host->pdev->dev,
+                     "Insufficient timing margin in flat map: %d (minimum %d)\n",
+                     max_consecutive_length, EFX_EMMC_MIN_TIMING_MARGIN);
+        }
+
+        // DDR and SDR modes using different selection strategy for better tuning results
+        if (host->mmc->ios.timing == MMC_TIMING_MMC_HS400) {
+            // DDR mode: select center of longest consecutive 1's for better stability as DDR is more sensitive to timing
+            // For DDR mode, find the center of the longest consecutive 1's
+            original_length = max_sample_count * EFX_EMMC_MAX_PLL_SHIFT;
+            selected_index = efx_emmc_find_center_of_consecutive_ones(flat_map, flat_length);
+            if (selected_index < 0) {
+                kfree(flat_map);
+                return -ENODEV;
+            }
+            selected_index = selected_index % original_length; // Map it back to the original range
+
+            // Find sample count range
+            optimal_sample_count = selected_index / EFX_EMMC_MAX_PLL_SHIFT;
+            // Find PLL shift range
+            optimal_pll_shift = selected_index % EFX_EMMC_MAX_PLL_SHIFT;
+
+            dev_info(&host->pdev->dev,
+                     "DDR mode - optimal timing found: sample_count=%u, pll_shift=%u, margin=%d\n",
+                     optimal_sample_count, optimal_pll_shift, max_consecutive_length);
+        } else {
+            /* SDR mode:
+               If tuning_result_selection_edge is false, select the center of the longest consecutive 1's
+               If tuning_result_selection_edge is true, select the first or last occurrence of the longest
+               consecutive 1's based on tuning_first_half_sample.
+               If first_half_sample is true, select the last occurrence
+               If first_half_sample is false, select the first occurrence
+            */
+            original_length = max_sample_count * EFX_EMMC_MAX_PLL_SHIFT;
+
+            // Default is based on center of the map result
+            if (!host->tuning_result_selection_edge) {
+                selected_index = efx_emmc_find_center_of_consecutive_ones(flat_map, flat_length);
+                dev_info(&host->pdev->dev,
+                    "SDR mode - using center of longest consecutive 1's\n");
+            } else {
+	            selected_index = efx_emmc_find_first_or_last_consecutive_ones(
+			            flat_map, flat_length, !host->tuning_first_half_sample);
+                dev_info(&host->pdev->dev,
+                    "SDR mode - using %s occurrence of longest consecutive 1's\n",
+                    host->tuning_first_half_sample ? "last" : "first");
+            }
+	        if (selected_index < 0) {
+	            kfree(flat_map);
+		        return -ENODEV;
+	        }
+
+	        selected_index = selected_index % original_length;
+	        optimal_sample_count = selected_index / EFX_EMMC_MAX_PLL_SHIFT;
+	        optimal_pll_shift = selected_index % EFX_EMMC_MAX_PLL_SHIFT;
+
+	        dev_info(&host->pdev->dev,
+                    "SDR mode - optimal timing found: sample_count=%u, pll_shift=%u, margin=%d\n",
+                    optimal_sample_count, optimal_pll_shift, max_consecutive_length);
+            }
+
+        kfree(flat_map);
+    }
+
+    if (host->mmc->ios.timing == MMC_TIMING_MMC_HS200) {
+        host->hs200_sample_count = optimal_sample_count;
+        host->hs200_pll_shift = optimal_pll_shift;
+        host->hs200_margin = max_consecutive_length;
+    } else if (host->mmc->ios.timing == MMC_TIMING_MMC_HS400) {
+        host->hs400_sample_count = optimal_sample_count;
+        host->hs400_pll_shift = optimal_pll_shift;
+        host->hs400_margin = max_consecutive_length;
+    }
+    return 0;
 }
 
