+        u8 *flat_map;
+        int flat_length;
+
+        // Append the same result_map to make it look like 1D for better center calculation
+        // Double the result_map
+        flat_length = max_sample_count * EFX_EMMC_MAX_PLL_SHIFT * 2;
+        flat_map = kmalloc(flat_length, GFP_KERNEL);
+        if (!flat_map) {
+            kfree(optimal_rows);
+            return -ENOMEM;
+        }
+
+        for (i = 0; i < max_sample_count; i++) {
+            for (j = 0; j < EFX_EMMC_MAX_PLL_SHIFT; j++) {
+                flat_map[i * EFX_EMMC_MAX_PLL_SHIFT + j] = result_map[i][j];
+                flat_map[(i + max_sample_count) * EFX_EMMC_MAX_PLL_SHIFT + j] = result_map[i][j];
