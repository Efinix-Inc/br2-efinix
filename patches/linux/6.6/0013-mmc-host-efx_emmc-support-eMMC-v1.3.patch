+// A function that finds the first or last occurrence of the longest consecutive 1's based on argument
+static int efx_emmc_find_first_or_last_consecutive_ones(u8 *row, int length, bool find_first)
+{
+    int max_len = 0;
+    int current_len = 0;
+    int max_start = -1;
+    int current_start = -1;
+    int i;
+
+    for (i = 0; i < length; i++) {
+        if (row[i] == 1) {
+            if (current_len == 0) {
+                current_start = i;
+            }
+            current_len++;
+            if (current_len > max_len) {
+                max_len = current_len;
+                max_start = current_start;
+            }
+        } else {
+            current_len = 0;
+        }
+    }
+
+    if (max_start == -1) {
+        return -1;
+    }
+
+    if (find_first) {
+        return max_start;
+    } else {
+        return max_start + max_len - 1;
+    }
+}
+
 static int efx_emmc_find_center_of_consecutive_ones(u8 *row, int length)
