From b26de52897cbec27ac8b0c7ed18abe0007ab7922 Mon Sep 17 00:00:00 2001
From: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
Date: Sat, 15 Nov 2025 09:52:15 +0800
Subject: [PATCH] drivers: add spinal lib gpio driver

Signed-off-by: Mohamad Noor Alim Hussin <mnalim@efinixinc.com>
---
 drivers/gpio/Kconfig           |   6 +
 drivers/gpio/Makefile          |   1 +
 drivers/gpio/gpio-spinal-lib.c | 389 +++++++++++++++++++++++++++++++++
 3 files changed, 396 insertions(+)
 create mode 100644 drivers/gpio/gpio-spinal-lib.c

diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index 673bafb8be58..08128c0a5a8f 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -823,6 +823,12 @@ config GPIO_IDT3243X
 	  To compile this driver as a module, choose M here: the module will
 	  be called gpio-idt3243x.
 
+config GPIO_SPINAL_LIB
+	tristate "Spinal lib GPIO"
+	depends on OF_GPIO
+	select GPIOLIB_IRQCHIP
+	help
+	  Say Y or M here to build support for the Spinal Lib GPIO device.
 endmenu
 
 menu "Port-mapped I/O GPIO drivers"
diff --git a/drivers/gpio/Makefile b/drivers/gpio/Makefile
index eb73b5d633eb..42205d685d49 100644
--- a/drivers/gpio/Makefile
+++ b/drivers/gpio/Makefile
@@ -147,6 +147,7 @@ obj-$(CONFIG_GPIO_SIOX)			+= gpio-siox.o
 obj-$(CONFIG_GPIO_SL28CPLD)		+= gpio-sl28cpld.o
 obj-$(CONFIG_GPIO_SODAVILLE)		+= gpio-sodaville.o
 obj-$(CONFIG_GPIO_SPEAR_SPICS)		+= gpio-spear-spics.o
+obj-$(CONFIG_GPIO_SPINAL_LIB)		+= gpio-spinal-lib.o
 obj-$(CONFIG_GPIO_SPRD)			+= gpio-sprd.o
 obj-$(CONFIG_GPIO_STMPE)		+= gpio-stmpe.o
 obj-$(CONFIG_GPIO_STP_XWAY)		+= gpio-stp-xway.o
diff --git a/drivers/gpio/gpio-spinal-lib.c b/drivers/gpio/gpio-spinal-lib.c
new file mode 100644
index 000000000000..6b05e6fd5195
--- /dev/null
+++ b/drivers/gpio/gpio-spinal-lib.c
@@ -0,0 +1,389 @@
+// SPDX-License-Identifier: GPL-3.0
+
+#include <linux/bitops.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/of_irq.h>
+#include <linux/gpio/driver.h>
+#include <linux/irqchip/chained_irq.h>
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/pm.h>
+#include <linux/slab.h>
+#include <linux/interrupt.h>
+#include <linux/spinlock.h>
+
+#define GPIO_INPUT		0x0
+#define GPIO_OUTPUT		0x4
+#define GPIO_OUTPUT_ENABLE	0x8
+#define GPIO_RISE_IE		0x20
+#define GPIO_FALL_IE		0x24
+#define GPIO_HIGH_IE		0x28
+#define GPIO_LOW_IE		0x2C
+
+#define MAX_GPIO	32
+
+struct spinal_lib_gpio {
+	raw_spinlock_t	lock;
+	void __iomem	*base;
+	struct gpio_chip gc;
+	unsigned int 	ngpios;
+	unsigned int 	num_parents;
+	unsigned int 	*irq_parent;
+	unsigned int 	trigger[MAX_GPIO];
+	u32		interrupt_mask;
+	unsigned long enabled;
+};
+
+static struct irq_chip spinal_lib_gpio_irqchip;
+
+static void spinal_lib_gpio_assign_bit(void __iomem *ptr, int offset, bool enable)
+{
+	u32 mask = BIT(offset);
+	u32 old = readl_relaxed(ptr);
+
+	if (enable)
+		writel_relaxed(old | mask, ptr);
+	else
+		writel_relaxed(old & ~mask, ptr);
+}
+
+static int spinal_lib_gpio_direction_input(struct gpio_chip *gc, unsigned offset)
+{
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	unsigned long flags;
+
+	if (offset >= gc->ngpio)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_OUTPUT_ENABLE, offset, false);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+
+
+	return 0;
+}
+
+static int spinal_lib_gpio_direction_output(struct gpio_chip *gc, unsigned offset, int value)
+{
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	unsigned long flags;
+
+	if (offset >= gc->ngpio)
+		return -EINVAL;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_OUTPUT, offset, value);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_OUTPUT_ENABLE,  offset, 1);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+
+	return 0;
+}
+
+static int spinal_lib_gpio_get_direction(struct gpio_chip *gc, unsigned offset)
+{
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+
+	if (offset >= gc->ngpio)
+		return -EINVAL;
+
+	return !(ioread32(chip->base + GPIO_OUTPUT_ENABLE) & BIT(offset));
+}
+
+static int spinal_lib_gpio_get_value(struct gpio_chip *gc, unsigned offset)
+{
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+
+	if (offset >= gc->ngpio)
+		return -EINVAL;
+
+	return !!(ioread32(chip->base + GPIO_INPUT) & BIT(offset));
+}
+
+static void spinal_lib_gpio_set_value(struct gpio_chip *gc, unsigned offset, int value)
+{
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	unsigned long flags;
+
+	if (offset >= gc->ngpio)
+		return;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_OUTPUT, offset, value);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+}
+
+static void spinal_lib_gpio_set_ie(struct spinal_lib_gpio *chip, int offset)
+{
+	unsigned long flags;
+	unsigned int type;
+	bool line_enabled, line_unmasked;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	type = chip->trigger[offset];
+	line_enabled = !!(chip->enabled & BIT(offset));
+	// 0 = unmasked
+	line_unmasked = !(chip->interrupt_mask & BIT(offset));
+	/* If not enabled or masked, disable all IE for this line */
+	if (!line_enabled || !line_unmasked) {
+		spinal_lib_gpio_assign_bit(chip->base + GPIO_RISE_IE, offset, false);
+		spinal_lib_gpio_assign_bit(chip->base + GPIO_FALL_IE, offset, false);
+		spinal_lib_gpio_assign_bit(chip->base + GPIO_HIGH_IE, offset, false);
+		spinal_lib_gpio_assign_bit(chip->base + GPIO_LOW_IE,  offset, false);
+		raw_spin_unlock_irqrestore(&chip->lock, flags);
+		return;
+	}
+
+	/* Enabled only selected type, diable others */
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_RISE_IE, offset, type & IRQ_TYPE_EDGE_RISING);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_FALL_IE, offset, type & IRQ_TYPE_EDGE_FALLING);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_HIGH_IE, offset, type & IRQ_TYPE_LEVEL_HIGH);
+	spinal_lib_gpio_assign_bit(chip->base + GPIO_LOW_IE,  offset, type & IRQ_TYPE_LEVEL_LOW);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+}
+
+static void spinal_lib_gpio_irq_mask(struct irq_data *d)
+{
+	unsigned long flags;
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	int offset = irqd_to_hwirq(d);
+
+	if (offset < 0 || offset >= gc->ngpio)
+		return;
+
+	if (offset != 0 && offset != 1)
+		return;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	// masked = 1, enabled = 0
+	chip->interrupt_mask |= BIT(offset);
+	chip->enabled &= ~BIT(offset);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+
+	spinal_lib_gpio_set_ie(chip, offset);
+}
+
+static void spinal_lib_gpio_irq_unmask(struct irq_data *d)
+{
+	unsigned long flags;
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	int offset = irqd_to_hwirq(d);
+
+	if (offset < 0 || offset >= gc->ngpio)
+		return;
+
+	/* If only 0 or 1 are IRQ-capable */
+	if (offset != 0 && offset != 1)
+		return;
+
+	raw_spin_lock_irqsave(&chip->lock, flags);
+	chip->interrupt_mask &= ~BIT(offset);
+	chip->enabled |= BIT(offset);
+	raw_spin_unlock_irqrestore(&chip->lock, flags);
+
+	spinal_lib_gpio_set_ie(chip, offset);
+}
+
+static void spinal_lib_gpio_irq_enable(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	int offset = irqd_to_hwirq(d);
+
+	/* Switch to input */
+	spinal_lib_gpio_direction_input(gc, offset);
+
+	/* Enable interrupts */
+	assign_bit(offset, &chip->enabled, 1);
+	spinal_lib_gpio_irq_unmask(d);
+}
+
+static void spinal_lib_gpio_irq_disable(struct irq_data *d)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	int offset = irqd_to_hwirq(d);
+
+	assign_bit(offset, &chip->enabled, 0);
+	spinal_lib_gpio_set_ie(chip, offset);
+}
+
+static int spinal_lib_gpio_irq_set_type(struct irq_data *d, unsigned int type)
+{
+	struct gpio_chip *gc = irq_data_get_irq_chip_data(d);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	int offset = irqd_to_hwirq(d);
+
+	if (offset < 0 || offset >= gc->ngpio)
+		return -EINVAL;
+
+	/* Only pins 0 and 1 can be IRQ sources */
+	if (offset != 0 && offset != 1)
+		return -EINVAL;
+
+	if (gc->direction_input)
+		gc->direction_input(gc, offset);
+
+	chip->trigger[offset] = type;
+	spinal_lib_gpio_set_ie(chip, offset);
+
+	if (type & IRQ_TYPE_LEVEL_MASK)
+		irq_set_chip_handler_name_locked(d, &spinal_lib_gpio_irqchip,
+						 handle_fasteoi_irq, NULL);
+	else
+		irq_set_chip_handler_name_locked(d, &spinal_lib_gpio_irqchip,
+						 handle_level_irq, NULL);
+	return 0;
+}
+
+static struct irq_chip spinal_lib_gpio_irqchip = {
+	.name		= "spinal_lib_gpio-gpio",
+	.irq_set_type	= spinal_lib_gpio_irq_set_type,
+	.irq_mask	= spinal_lib_gpio_irq_mask,
+	.irq_unmask	= spinal_lib_gpio_irq_unmask,
+	.irq_enable	= spinal_lib_gpio_irq_enable,
+	.irq_disable	= spinal_lib_gpio_irq_disable,
+	.flags		= IRQCHIP_SET_TYPE_MASKED |
+			  IRQCHIP_MASK_ON_SUSPEND |
+			  IRQCHIP_IMMUTABLE,
+	GPIOCHIP_IRQ_RESOURCE_HELPERS,
+};
+
+static void spinal_lib_gpio_irq_handler(struct irq_desc *desc)
+{
+	struct irq_chip *pch = irq_desc_get_chip(desc);
+	struct gpio_chip *gc = irq_desc_get_handler_data(desc);
+	struct spinal_lib_gpio *chip = gpiochip_get_data(gc);
+	struct irq_data *d = irq_desc_get_irq_data(desc);
+	int parent_virq = d->irq;
+
+	chained_irq_enter(pch, desc);
+	if (parent_virq == chip->irq_parent[0]) {
+		generic_handle_domain_irq(gc->irq.domain, 0);
+	} else if (parent_virq == chip->irq_parent[1]) {
+		generic_handle_domain_irq(gc->irq.domain, 1);
+	}
+	chained_irq_exit(pch, desc);
+}
+
+static void spinal_lib_init_valid_mask(struct gpio_chip *gc,
+				      unsigned long *valid_mask,
+				      unsigned int ngpios)
+{
+	/* Mark only GPIO 0 and 1 as IRQ-capable */
+	bitmap_zero(valid_mask, ngpios);
+	if (ngpios > 0)
+		__set_bit(0, valid_mask);
+	if (ngpios > 1)
+		__set_bit(1, valid_mask);
+}
+
+static int spinal_lib_gpio_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *node = pdev->dev.of_node;
+	struct spinal_lib_gpio *chip;
+	struct resource *res;
+	struct gpio_chip *gc;
+	struct gpio_irq_chip *girq;
+	int i, ret, pirq;
+
+	chip = devm_kzalloc(dev, sizeof(*chip), GFP_KERNEL);
+	if(!chip)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	chip->base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(chip->base)) {
+		dev_err(dev, "failed to allocate device memory\n");
+		return PTR_ERR(chip->base);
+	}
+
+	if (of_property_read_u32(node, "ngpio", &chip->ngpios))
+		chip->ngpios = MAX_GPIO;
+
+	if (chip->ngpios > MAX_GPIO) {
+		dev_err(dev, "too many GPIO\n");
+		return -EINVAL;
+	}
+
+	raw_spin_lock_init(&chip->lock);
+	chip->interrupt_mask = BIT(0) | BIT(1);
+	chip->enabled = 0;
+
+	gc = &chip->gc;
+	gc->label = dev_name(dev);
+	gc->parent = dev;
+	gc->owner = THIS_MODULE;
+	gc->base = -1;
+	gc->ngpio = chip->ngpios;
+	gc->fwnode = dev_fwnode(dev);
+	gc->get_direction = spinal_lib_gpio_get_direction;
+	gc->direction_input = spinal_lib_gpio_direction_input;
+	gc->direction_output = spinal_lib_gpio_direction_output;
+	gc->get = spinal_lib_gpio_get_value;
+	gc->set = spinal_lib_gpio_set_value;
+
+	girq = &chip->gc.irq;
+	gpio_irq_chip_set_chip(girq, &spinal_lib_gpio_irqchip);
+	girq->default_type = IRQ_TYPE_NONE;
+	girq->init_valid_mask = spinal_lib_init_valid_mask;
+	girq->num_parents = of_irq_count(dev->of_node);
+	girq->parents = devm_kcalloc(dev, girq->num_parents,
+				     sizeof(*girq->parents),
+				     GFP_KERNEL);
+	girq->handler = handle_level_irq;
+	girq->parent_handler = spinal_lib_gpio_irq_handler;
+
+	chip->num_parents = of_irq_count(dev->of_node);
+	chip->irq_parent = devm_kcalloc(dev, girq->num_parents,
+					sizeof(*chip->irq_parent),
+					GFP_KERNEL);
+
+	/* Disable all GPIO interrupts before enabling parent interrupts */
+        writel_relaxed(0, chip->base + GPIO_OUTPUT_ENABLE);
+        writel_relaxed(0, chip->base + GPIO_RISE_IE);
+        writel_relaxed(0, chip->base + GPIO_FALL_IE);
+        writel_relaxed(0, chip->base + GPIO_HIGH_IE);
+        writel_relaxed(0, chip->base + GPIO_LOW_IE);
+
+	platform_set_drvdata(pdev, chip);
+
+	for (i = 0; i < chip->num_parents; i++) {
+		pirq = platform_get_irq(pdev, i);
+		if (pirq < 0)
+			return pirq;
+		chip->irq_parent[i] = pirq;
+		girq->parents[i] = pirq;
+	}
+
+	ret = gpiochip_add_data(&chip->gc, chip);
+	if (ret) {
+		dev_err(dev, "Failed to register gpio controller\n");
+		return ret;
+	}
+
+	dev_info(dev, "Spinal lib GPIO chip registered %d GPIOs with %u parents\n", chip->ngpios, chip->num_parents);
+
+	return 0;
+}
+
+static const struct of_device_id spinal_lib_gpio_match[] = {
+	{
+		.compatible = "spinal-lib,gpio-1.0",
+	},
+	{ },
+};
+
+static struct platform_driver spinal_lib_gpio_driver = {
+	.probe		= spinal_lib_gpio_probe,
+	.driver = {
+		.name	= "spinal_lib_gpio",
+		.of_match_table = of_match_ptr(spinal_lib_gpio_match),
+	},
+};
+builtin_platform_driver(spinal_lib_gpio_driver)
-- 
